# Copie para .env e ajuste. Carregue com: node --env-file=.env server.js
# (o .env NUNCA vai para o Git; este arquivo .env.example é só o modelo, sem segredos reais)

PORT=3000

# --- Segurança dos logins -------------------------------------------------------------------------------------------------
# Segredo que assina os tokens de login. Em desenvolvimento pode ficar vazio: o servidor gera um segredo único em
# server/data/jwt.secret (ignorado pelo Git) e reaproveita nas próximas execuções.
# OBRIGATÓRIO em produção (NODE_ENV=production), com pelo menos 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origens externas autorizadas a chamar a API (CORS), separadas por vírgula. Vazio = só o próprio site (o normal).
# Exemplo: CORS_ORIGINS=https://meu-app.exemplo.com
CORS_ORIGINS=

# Atrás de proxy/hospedagem (Render, Railway, Nginx...): quantos proxies confiar para descobrir o IP real do visitante
# (usado pelo limite de tentativas de login). Em geral 1. Vazio = não confiar.
TRUST_PROXY=

# --- Login com Google (opcional) ------------------------------------------------------------------------------------------
# Sem isto o botão "Continuar com Google" NÃO aparece. Passo a passo no README ("Login com Google").
GOOGLE_CLIENT_ID=

# --- Outros ---------------------------------------------------------------------------------------------------------------
# 1 = cria a conta de demonstração (demo@showvault.local) na primeira execução. Ignorado em produção. Padrão: desligado.
SEED_DEMO_USER=

# Pasta onde ficam usuários, bibliotecas, catálogo e segredo (padrão: server/data). Em hospedagem, aponte para um volume persistente.
SHOWVAULT_DATA_DIR=

# Onde guardar usuários, bibliotecas e o catálogo vivo: json (padrão; arquivos na pasta de dados) ou sqlite (um único arquivo
# showvault.sqlite na pasta de dados; exige Node 26+). Ao trocar para sqlite os JSON existentes são importados uma vez, com backup.
STORAGE=

# --- Busca de séries e filmes com TMDB (opcional) ---------------------------------------------------------------------------
# Sem a chave o app funciona normalmente (catálogo local + TVMaze para séries + AniList/Jikan para animes), mas NÃO busca
# filmes novos. Para ativar: crie uma conta grátis em themoviedb.org > Configurações > API, copie a "Chave da API (v3)" ou o
# "Token de Leitura da API (v4)" e cole aqui. Os títulos vêm em português (pt-BR). Nunca commite esta chave.
TMDB_API_KEY=

# --- Animes: AniList (principal) e Jikan (reserva) — S13 ------------------------------------------------------------------
# A AniList (https://graphql.anilist.co, GraphQL, sem chave) é a fonte principal de anime; se ela falhar, o app tenta a Jikan/MyAnimeList.
# Só mude isto para apontar para uma AniList FALSA em testes/desenvolvimento local (vazio = endereço oficial).
ANILIST_BASE_URL=
# Obras "Em Exibição" buscam episódios novos sozinhas: de quantas em quantas HORAS uma obra vence (padrão 6) e de quantos em quantos
# MINUTOS o servidor confere o que venceu (padrão 30; 0 desliga a conferência automática; a rota POST /api/media/:id/refresh continua valendo).
MEDIA_AIRING_TTL_HOURS=
MEDIA_REFRESH_INTERVAL_MIN=

# --- Desempenho (opcional) ------------------------------------------------------------------------------------------------
# Quantos segundos o navegador pode reutilizar CSS/JS/imagens sem perguntar ao servidor. Padrão: 3600 em produção, 0 fora dela
# (sempre confere; o index.html nunca é reutilizado sem conferir).
STATIC_MAX_AGE_SEC=
