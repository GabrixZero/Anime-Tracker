# Copie para .env e ajuste. Carregue com: node --env-file=.env server.js
# (o .env NUNCA vai para o Git; este arquivo .env.example é só o modelo, sem segredos reais)

PORT=3000

# --- Segurança dos logins -------------------------------------------------------------------------------------------------
# Segredo que assina os tokens de login. Em desenvolvimento pode ficar vazio: o servidor gera um segredo único em
# server/data/jwt.secret (ignorado pelo Git) e reaproveita nas próximas execuções.
# OBRIGATÓRIO em produção (NODE_ENV=production), com pelo menos 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origens externas autorizadas a chamar a API (CORS), separadas por vírgula. Vazio = só o próprio site (o normal).
# Exemplo: CORS_ORIGINS=https://meu-app.exemplo.com
CORS_ORIGINS=

# Atrás de proxy/hospedagem (Render, Railway, Nginx...): quantos proxies confiar para descobrir o IP real do visitante
# (usado pelo limite de tentativas de login). Em geral 1. Vazio = não confiar.
TRUST_PROXY=

# --- Login com Google (opcional) ------------------------------------------------------------------------------------------
# Sem isto o botão "Continuar com Google" NÃO aparece. Passo a passo no README ("Login com Google").
GOOGLE_CLIENT_ID=

# --- Outros ---------------------------------------------------------------------------------------------------------------
# 1 = cria a conta de demonstração (demo@showvault.local) na primeira execução. Ignorado em produção. Padrão: desligado.
SEED_DEMO_USER=

# Pasta onde ficam usuários, bibliotecas, catálogo e segredo (padrão: server/data). Em hospedagem, aponte para um volume persistente.
SHOWVAULT_DATA_DIR=
